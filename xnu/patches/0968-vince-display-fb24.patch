+/*
+ * vince: ordinary cached pages published as a surface. The panel there is scanned out as packed
+ * 24 bpp, which iOS cannot draw into, so the default surface is a 32 bpp copy in plain memory and
+ * the framebuffer converts what is shown from it into the panel.
+ */
+SweetSurface *
+sweet_surface_create_buffer(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = width * 4;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)sweet_round_upage((uint64_t)s->bytesPerRow * height);
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, SWEET_UPAGE);
+	if (mem == NULL) {
+		s->release();
+		return NULL;
+	}
+	bzero(mem->getBytesNoCopy(), s->allocSize);
+	OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired);   /* free() takes it back */
+	s->memory = mem;
+	s->mapCache = kIOMapDefaultCache;
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
