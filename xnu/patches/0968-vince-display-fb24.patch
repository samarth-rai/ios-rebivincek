+/*
+ * Convert the shadow (BGRA, logical size) into the panel: 4 pixels make 3 words. Nearest
+ * neighbour when the logical frame is larger than the panel.
+ */
+void
+AppleCLCD::blitVince(void)
+{
+	const uint32_t *shadow = (const uint32_t *)fShadowVA;
+	uint8_t *panel = (uint8_t *)fPixels;
+
+	for (uint32_t y = 0; y < fHeight; y++) {
+		const uint32_t *row = shadow + (uint64_t)(((uint64_t)y * fLogicalH) / fHeight) * fLogicalW;
+		uint32_t *out = (uint32_t *)(panel + (uint64_t)y * fRowBytes);
+		for (uint32_t x = 0; x + 4 <= fWidth; x += 4) {
+			uint32_t p0 = row[fXMap[x]], p1 = row[fXMap[x + 1]], p2 = row[fXMap[x + 2]], p3 = row[fXMap[x + 3]];
+			out[0] = (p0 & 0x00ffffffu) | (p1 << 24);
+			out[1] = ((p1 >> 8) & 0x0000ffffu) | (p2 << 16);
+			out[2] = ((p2 >> 16) & 0x000000ffu) | (p3 << 8);
+			out += 3;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
