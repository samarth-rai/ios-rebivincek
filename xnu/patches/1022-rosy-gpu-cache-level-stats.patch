  * cleans+invalidates the buffer: before a submit (what the CPU wrote must reach RAM, and no dirty line may later be
  * written over what the GPU wrote) and after the fence in cpu_prep (the CPU must not read stale lines).
  */
-static bool
-cacheMode(void)
+/*
+ * vincecache=2: the window server's mappings are write-combined again, and nothing is cleaned at a submit -- with
+ * vinceplace=1 the processor no longer reads the frames back, and cleaning every buffer a submit names (whole
+ * textures and screens, tens of megabytes, at every glFlush) cost more than the GPU took. What the kernel reads
+ * (the display, vince_surface_sync) it still reads through a cached mapping of its own, cleaned first. Reading
+ * back what is not drawn in place (glReadPixels) is slow again in this mode.
+ */
+static int
+cacheLevel(void)
 {
 	static int mode = -1;
 	if (mode < 0) {
 		uint32_t v = 0;
-		mode = (PE_parse_boot_argn("vincecache", &v, sizeof(v)) && v) ? 1 : 0;
+		mode = (PE_parse_boot_argn("vincecache", &v, sizeof(v)) && v) ? (v == 2 ? 2 : 1) : 0;
 	}
-	return mode == 1;
+	return mode;
+}
+
+static bool
+cacheMode(void)
+{
+	return cacheLevel() == 1;
+}
+
+/* What the window server's GL costs in here, for the line vince_gpu_stats_log() writes (every 10 s of the display's ticks). */
+static volatile uint64_t gStatSubmits, gStatSyncBytes, gStatSyncNs, gStatSubmitNs, gStatPreps, gStatPrepNs, gStatFences, gStatFenceNs,
+    gStatShowNs, gStatShows;
+
+static uint64_t
+statSince(uint64_t began)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+	return ns;
+}
+
+void
+vince_gpu_stats_log(void)
+{
+	uint64_t submits = OSAddAtomic64(0, (volatile SInt64 *)&gStatSubmits);
+	static uint64_t last;
+
+	if (submits == last) {
+		return;                 /* nothing drawn since the last line */
+	}
+	last = submits;
+	IOLog("VinceGPU: %llu submits, %llu ms in them, of which %llu ms cleaning %llu MB of cache; %llu cpu_prep %llu ms; "
+	    "%llu fence waits %llu ms; the display waited %llu times, %llu ms (totals; vincecache level %d)\n",
+	    submits, gStatSubmitNs / 1000000, gStatSyncNs / 1000000, gStatSyncBytes >> 20, (uint64_t)gStatPreps, gStatPrepNs / 1000000,
+	    (uint64_t)gStatFences, gStatFenceNs / 1000000, (uint64_t)gStatShows, gStatShowNs / 1000000, cacheLevel());
 }
 
