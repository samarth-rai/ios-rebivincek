-			if (gpu_low || sweet_res_wanted()) {
+#if defined(TOPAZ_4K)
+			/* no GPU to share with: ordinary pages (boot-arg sweetscatter=0: contiguous as before) */
+			static int scatter = -1;
+			if (scatter < 0) {
+				uint32_t on = 1;
+				(void)PE_parse_boot_argn("sweetscatter", &on, sizeof(on));
+				scatter = on != 0;
+			}
+			if (!gpu_low && scatter) {
+				(void)sweet_surface_scatter(s, take);
+			}
+#endif
+			if (s->memory == NULL && (gpu_low || sweet_res_wanted())) {
 				sweet_res_fill();
 				if (s->width >= 1000 && s->height >= 2000 && s->bytesPerElement == 4) {
 					mem = sweet_res_take(take);
@@ -1254,12 +1314,18 @@
 				    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous, take,
 				    0x0000000FFFFFC000ull);
