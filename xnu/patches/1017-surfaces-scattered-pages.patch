 				mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
 				    kIODirectionInOut | kIOMemoryKernelUserShared, take, SWEET_UPAGE);
 			}
 		}
-		if (mem == NULL) {
+		if (s->memory != NULL) {
