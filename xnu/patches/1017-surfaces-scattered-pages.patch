From: rosy port
Subject: [PATCH] 1017 surfaces without the GPU: ordinary wired pages instead of one contiguous piece

rosy at the home screen (logs/usb-cpu4b): 1298 surface creates failed with kIOReturnNoMemory in half
an hour (PosterBoard 1125x2436, the poster extensions 1326x1326 and 1271x1823 planes), each after two
vm_page_find_contiguous() scans of all 732,000 pages; the poster extensions then died of "extension
check-in timeout" in a loop. A surface buffer only has to start on a 16 KiB boundary; the contiguity
came from how IOBufferMemoryDescriptor provides alignment above the 4 KiB kernel page. Buffers now
come from kernel_memory_allocate() with a 16 KiB address mask. Boot-arg sweetscatter=0 restores the
old behaviour; gpu=1 is unchanged (the GPU needs contiguous memory).
---
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -45,6 +45,9 @@
 #include <libkern/c++/OSUnserialize.h>
 #include <libkern/c++/OSSerialize.h>
 #include <sys/proc.h>
+__BEGIN_DECLS
+#include <vm/vm_kern.h>
+__END_DECLS
 
 /* topaz GPU (TopazAdreno.cpp): the GPU pool below 4 GiB */
 extern "C" uint64_t topaz_gpu_pool_alloc(uint64_t size, void **va);
@@ -320,10 +323,52 @@
 }
 
 OSDefineMetaClassAndStructors(SweetSurface, OSObject);
+
+/*
+ * TOPAZ_4K, without the GPU: pixels in ordinary wired pages. A surface buffer must start on a 16 KiB
+ * boundary (the user page) and IOBufferMemoryDescriptor gives an alignment above the kernel's 4 KiB
+ * page only as one physically contiguous piece. Once userland runs there are no such pieces: on rosy
+ * 1298 creates failed in half an hour (PosterBoard's screens, the posters' 1326x1326 planes), each
+ * after two scans of all of RAM. Here the pages come from kernel_memory_allocate() with a 16 KiB
+ * address mask (its own VM object, offset 0 at that address: both aligned, pages anywhere), and the
+ * surface's memory is a descriptor of that kernel range, mapped into tasks like any other.
+ */
+static bool
+sweet_surface_scatter(SweetSurface *s, uint64_t size)
+{
+	vm_offset_t va = 0;
+
+	size = sweet_round_upage(size);
+	if (kernel_memory_allocate(kernel_map, &va, (vm_size_t)size, (vm_offset_t)(SWEET_UPAGE - 1),
+	    (kma_flags_t)(KMA_DATA | KMA_ZERO), VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS || va == 0) {
+		return false;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(va, size, kIODirectionInOut, kernel_task);
+	if (md == NULL || md->prepare() != kIOReturnSuccess) {
+		OSSafeReleaseNULL(md);
+		kmem_free(kernel_map, va, (vm_size_t)size);
+		return false;
+	}
+	s->memory = md;
+	s->scatterVA = va;
+	s->scatterSize = size;
+	return true;
+}
 
 void
 SweetSurface::free()
 {
+	if (scatterVA != 0) {
+		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&sweet_surface_wired);
+		OSSafeReleaseNULL(kernelMap);
+		if (memory != NULL) {
+			memory->complete();
+			OSSafeReleaseNULL(memory);
+		}
+		/* tasks that still map it keep the pages through their own references to the VM object */
+		kmem_free(kernel_map, scatterVA, (vm_size_t)scatterSize);
+		scatterVA = 0;
+	}
 	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
 		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&sweet_surface_wired);
 	}
@@ -357,6 +402,9 @@
 	if (buffer != NULL) {
 		return (uintptr_t)buffer->getBytesNoCopy();
 	}
+	if (scatterVA != 0) {
+		return scatterVA;
+	}
 	IOLockLock(sweet_surface_lock);
 	if (kernelMap == NULL && memory != NULL) {
 		kernelMap = memory->map(vincePool ? kIOMapCopybackCache : (scanoutPhys || wrapped) ? kIOMapDefaultCache : kIOMapWriteCombineCache);
